<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- POMP NET Night Theme -->

    <style name="AppThemeBase"
        parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- POMP NET black background -->
        <item name="android:windowBackground">#FF050509</item>

        <!-- Transparent system bars -->
        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

        <!-- Dark status/navigation icons -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <style name="AppThemeDayNight"
        parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar"
        parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent"
        parent="AppThemeBase">

        <item name="android:windowBackground">
            @android:color/transparent
        </item>

        <item name="android:windowIsTranslucent">true</item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

    </style>

</resources>
