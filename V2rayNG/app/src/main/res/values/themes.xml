<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- POMP NET -->
    <color name="window_background_light">#FF050509</color>
    <color name="window_background_dark">#FF050509</color>

    <style name="AppThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">

        <!-- POMP NET background -->
        <item name="android:windowBackground">@color/window_background_light</item>

        <!-- Transparent system bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Dark POMP NET UI -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Keep app drawing stable -->
        <item name="android:windowActionModeOverlay">true</item>

    </style>

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar"
        parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent"
        parent="AppThemeBase">

        <item name="android:windowBackground">
            @android:color/transparent
        </item>

        <item name="android:windowIsTranslucent">true</item>

        <item name="android:statusBarColor">
            @android:color/transparent
        </item>

        <item name="android:navigationBarColor">
            @android:color/transparent
        </item>

    </style>

</resources>
